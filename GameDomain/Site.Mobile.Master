<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Mobile.master.cs" Inherits="GameDomain.Site_Mobile" %>
<%@ Register Src="~/ViewSwitcher.ascx" TagPrefix="friendlyUrls" TagName="ViewSwitcher" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Game Domain</title>
    <asp:ContentPlaceHolder runat="server" ID="HeadContent" />
    
    <!-- This ensures the mobile page loads my main CSS styling -->
    <webopt:bundlereference runat="server" path="~/Content/css" />
</head>



<body> <!-- Essentially you copy the body, header and footer from the main site master to here..only diff between the two are the top (head) and the friendly thing at the bottom -->
    <form id="form1" runat="server">
        
        <!-- Custom Game Domain Navigation Header -->
        <div style="background-color: rgba(0, 0, 0, 0.8); padding: 1.5% 2%; text-align: center; position: sticky; top: 0; z-index: 1000; display: flex; align-items: center; justify-content: space-around; flex-wrap: wrap; box-sizing: border-box;">
            <div style="display: flex; align-items: center;">
                <img src="Assets/Logo.png" alt="Logo" style="max-height: 60px; margin-left: 2%; border-radius: 50%;"> 
                <h1 style="font-size: xx-large; color: white; margin: 0; margin-left: 2%;">GAME DOMAIN</h1>
            </div>

            <div style="display: flex; align-items: center; flex-wrap: nowrap; margin-top: 1%;">
                <a href="Default.aspx" style="font-size: large; color: rgb(42, 124, 211); text-decoration: none; margin: 0 0.7%; white-space: nowrap;"><b>HOME</b></a>
                <a href="Products.aspx" style="font-size: large; color: rgb(42, 124, 211); text-decoration: none; margin: 0 0.7%; white-space: nowrap;"><b>PRODUCTS</b></a>
                <a href="About.aspx" style="font-size: large; color: rgb(42, 124, 211); text-decoration: none; margin: 0 0.7%; white-space: nowrap;"><b>ABOUT US</b></a>
                <a href="Contact.aspx" style="font-size: large; color: rgb(42, 124, 211); text-decoration: none; margin: 0 0.7%; white-space: nowrap;"><b>CONTACT US</b></a>
            </div>
        </div>

        <!-- Main Content Container -->
        <div class="container body-content">
            <asp:ContentPlaceHolder runat="server" ID="FeaturedContent" />
            <section class="content-wrapper main-content clear-fix">
                <asp:ContentPlaceHolder runat="server" ID="MainContent" />
            </section>
            <hr />

            <!-- Custom Game Domain Footer -->
            <footer>
                <div style="background-color: rgb(42, 124, 211); color: #fff; text-align: center; padding: 1.5%; border-radius: 3vw; width: auto; margin: 2% auto;">
                    <img src="Assets/Logo.png" alt="Logo" style="max-height: 60px; margin-left: 2%; border-radius: 50%;">
                    <p style="color: #f2f2f2; margin: 0;">&copy; <%: DateTime.Now.Year %> Game Domain. All rights reserved.</p>
                    <p style="color: #f2f2f2; margin: 0;">Phone: (876) 435-1367</p>
                    <p style="color: #f2f2f2; margin: 0;">Email: <a href="mailto:GameDomain@gmail.com" style="color: white; text-decoration: underline;">gamedomain@gmail.com</a></p>              
                </div>
            </footer>
        </div>

        <!-- Renders the hidden ViewSwitcher securely -->
        <friendlyUrls:ViewSwitcher runat="server" />
    </form>
</body>
</html>